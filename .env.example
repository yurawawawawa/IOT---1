# Gunakan ID sama persis pada laptop, HP A, dan HP B.
PROJECT_ID=buddycheck_ganti_dengan_id_kelompok
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
# Dashboard tersedia di jaringan lokal. Jangan teruskan port ke internet.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Nilai awal untuk eksperimen; kalibrasikan dengan HP dan posisi pemakaian.
IMPACT_PEAK=8.0
IMPACT_ROTATION=0.35
STILL_RMS=0.6
STILL_ROTATION=0.15
STILL_SECONDS=5
OBSERVATION_SECONDS=12
OFFLINE_SECONDS=8
REPLY_SECONDS=30
CHECK_SECONDS=60
COOLDOWN_SECONDS=15
